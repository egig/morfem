{
  "name": "@egig/base",
  "version": "0.1.0",
  "description": "Schemaless, transactional document database with a CouchDB-shaped HTTP API. Runs in-process on Node, Bun, Deno, browsers and Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./workers": { "types": "./dist/workers.d.ts", "default": "./dist/workers.js" },
    "./stores/sqlite": { "types": "./dist/stores/sqlite.d.ts", "default": "./dist/stores/sqlite.js" },
    "./stores/d1": { "types": "./dist/stores/d1.d.ts", "default": "./dist/stores/d1.js" },
    "./base.wasm": "./dist/gen/base_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=22.5" }
}
